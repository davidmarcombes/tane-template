<!doctype html>
<html lang="{{ locale or lang or site.defaultLanguage }}" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ description or site.description }}" />

  {% include "partials/seo.njk" %}

  <!-- Favicons (generated at build time from src/assets/images/favicon.png) -->
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicons/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicons/favicon-16.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicons/favicon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicons/apple-touch-icon.png" />
  <meta name="theme-color" content="#ffffff">

  <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

    <!-- Dark mode: applied before first paint -->
    <script src="/assets/js/theme.js"></script>

    <link rel="stylesheet" href="/css/styles.css">

    <!-- Alpine.js (CSP build, self-hosted) -->
    <script defer src="/assets/js/alpine.min.js"></script>
  </head>
  <body class="bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-100">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:rounded focus:bg-white focus:text-slate-900 focus:shadow-lg">{{ i18n[lang or site.defaultLanguage].skipToContent }}</a>

    {% include "components/header.njk" %}

    <main id="main" tabindex="-1" class="max-w-6xl mx-auto px-4 py-8 focus:outline-none">
      {{ content | safe }}
    </main>

    {% include "components/footer.njk" %}
  </body>
</html>
